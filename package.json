{
  "name": "0g0-id",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev:id": "npm run dev -w workers/id",
    "dev:user": "npm run dev -w workers/user",
    "dev:admin": "npm run dev -w workers/admin",
    "migrate:id": "npm run migrate -w workers/id",
    "deploy:id": "npm run deploy -w workers/id",
    "deploy:user": "npm run deploy -w workers/user",
    "deploy:admin": "npm run deploy -w workers/admin",
    "dev:mcp": "npm run dev -w workers/mcp",
    "deploy:mcp": "npm run deploy -w workers/mcp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "vp config",
    "docs:api:generate": "node --import tsx scripts/generate-api-reference.ts --generate",
    "docs:api:check": "node --import tsx scripts/generate-api-reference.ts --check && node --import tsx scripts/check-bff-api-docs.ts --check"
  },
  "devDependencies": {
    "vite-plus": "0.1.24"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "npm@11.12.1"
}
