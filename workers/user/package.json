{
  "name": "workers-user",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:frontend": "cd frontend && npm ci && npm run build",
    "preflight:deploy": "tsx scripts/preflight-deploy.ts",
    "deploy": "npm run preflight:deploy && vp build && npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "@0g0-id/shared": "*",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.1",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@types/node": "^22.10.0",
    "happy-dom": "^20.9.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vite-plus": "0.1.24",
    "wrangler": "4.143.1"
  }
}
