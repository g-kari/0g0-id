{
  "name": "workers-user",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:frontend": "cd frontend && npm ci && npm run build",
    "preflight:deploy": "tsx scripts/preflight-deploy.ts",
    "deploy": "npm run preflight:deploy && vp build && npm run build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "@0g0-id/shared": "*",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "1.5.1",
    "wrangler": "4.158.0"
  }
}
