---
import Base from '../layouts/Base.astro';
import AccountFrame from '../components/AccountFrame.astro';
import Icon from '../components/Icon.astro';
---
<Base title="プロフィール — 0g0 ID">
  <div id="loading" class="page-state" role="status">
    <div class="spinner" aria-hidden="true"></div>
    <span>プロフィールを読み込み中...</span>
  </div>
  <div id="profile-error" class="page-state" style="display:none">
    <div class="settings-card recovery-panel">
      <h1>プロフィールを読み込めませんでした</h1>
      <p id="profile-error-message" role="alert"></p>
      <p class="section-description">通信状況を確認して、もう一度お試しください。</p>
      <button id="profile-retry-btn" type="button" class="btn btn-primary">もう一度読み込む</button>
      <a href="/" class="btn btn-ghost">トップへ戻る</a>
    </div>
  </div>
  <div id="content" style="display:none">
    <AccountFrame page="profile">
      <div slot="identity" class="profile-identity">
        <div id="avatar-container"></div>
        <div class="profile-identity-text"><div id="user-name">—</div></div>
      </div>
      <nav slot="navigation" class="account-nav" aria-label="アカウント設定">
        <span class="account-nav-item is-active" aria-current="page"><Icon name="user" /><span>プロフィール</span><Icon name="chevron" class="trailing" /></span>
        <a href="/sessions" class="account-nav-item"><Icon name="shield" /><span>セッション管理</span><Icon name="chevron" class="trailing" /></a>
        <a href="/connections" class="account-nav-item"><Icon name="link" /><span>連携サービス</span><Icon name="chevron" class="trailing" /></a>
        <a href="/providers" class="account-nav-item"><Icon name="link" /><span>SNS連携</span><Icon name="chevron" class="trailing" /></a>
        <a href="/login-history" class="account-nav-item"><Icon name="clock" /><span>ログイン履歴</span><Icon name="chevron" class="trailing" /></a>
        <a href="/login-stats" class="account-nav-item"><Icon name="chart" /><span>ログイン統計</span><Icon name="chevron" class="trailing" /></a>
        <div class="account-nav-separator"></div>
        <button id="logout-btn" class="account-nav-item" type="button"><Icon name="logout" /><span>ログアウト</span></button>
      </nav>

      <div class="user-section-title"><h2>プロフィール</h2></div>
      <div class="settings-card profile-form">
        <div class="form-card-title"><span class="form-card-icon"><Icon name="user" /></span><h3>基本情報</h3></div>
        <div class="form-divider"></div>
        <div class="form-row">
          <div class="form-label"><label for="name">名前</label></div>
          <div class="form-control"><input id="name" type="text" placeholder="名前を入力" /></div>
        </div>
        <div class="form-row">
          <div class="form-label"><span id="email-label">メールアドレス</span></div>
          <div class="form-control"><div id="user-email" class="readonly-value" aria-labelledby="email-label" aria-describedby="email-hint"></div><small id="email-hint" class="field-hint">この画面では変更できません。</small></div>
        </div>
        <div class="form-row">
          <div class="form-label"><label for="picture">プロフィール画像 URL</label></div>
          <div class="form-control"><input id="picture" type="url" placeholder="https://..." aria-describedby="picture-hint" /><small id="picture-hint" class="field-hint">画像のURLを指定してください。</small></div>
        </div>
        <div class="form-divider"></div>
        <h3 class="form-card-subhead">連絡先情報 <span>任意</span></h3>
        <div class="form-row">
          <div class="form-label"><label for="phone">電話番号</label></div>
          <div class="form-control"><input id="phone" type="tel" placeholder="090-0000-0000" /></div>
        </div>
        <div class="form-row">
          <div class="form-label"><label for="address">住所</label></div>
          <div class="form-control"><input id="address" type="text" placeholder="住所を入力" /></div>
        </div>
        <div class="form-actions">
          <p id="profile-save-status" role="status" aria-live="polite"></p>
          <button id="save-btn" class="btn btn-primary" type="button">保存</button>
        </div>
      </div>
      <div class="danger-area"><div><h3>アカウントの削除</h3><p>アカウントと関連するデータを削除します。</p></div><button id="delete-account-btn" class="btn btn-danger-quiet" type="button">アカウント削除</button></div>
    </AccountFrame>
  </div>

  <!-- アカウント削除確認ダイアログ -->
  <dialog id="delete-dialog" class="confirmation-dialog" aria-labelledby="delete-title">
    <div class="dialog-content">
      <h3 id="delete-title" class="danger-heading">アカウント削除</h3>
      <p class="section-description">この操作は取り消せません。すべてのデータ・セッションが削除されます。</p>
      <label for="delete-confirm-input">確認のため <strong>DELETE</strong> と入力してください。</label>
      <input id="delete-confirm-input" type="text" placeholder="DELETE" autocomplete="off" />
      <div class="dialog-actions">
        <button id="delete-cancel-btn" class="btn btn-ghost">キャンセル</button>
        <button id="delete-execute-btn" class="btn btn-danger" disabled>削除する</button>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import { apiFetch } from '../lib/api';
  import { showToast } from '../lib/toast';
  import { renderProfileAvatarHtml } from '../lib/safe-markup';
  import { createProfileLoader } from '../lib/profile-loader';
  import { createProfileSaver } from '../lib/profile-saver';
  import type { MyProfile } from '@0g0-id/api-types';

  const loading = document.getElementById('loading')!;
  const content = document.getElementById('content')!;
  const avatarContainer = document.getElementById('avatar-container')!;
  const userName = document.getElementById('user-name')!;
  const userEmail = document.getElementById('user-email')!;
  const nameInput = document.getElementById('name') as HTMLInputElement;
  const pictureInput = document.getElementById('picture') as HTMLInputElement;
  const phoneInput = document.getElementById('phone') as HTMLInputElement;
  const addressInput = document.getElementById('address') as HTMLInputElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;

  function renderAvatar(user: MyProfile) {
    avatarContainer.innerHTML = renderProfileAvatarHtml(user);
  }

  function renderSavedProfile(user: MyProfile) {
    userName.textContent = user.name ?? '—';
    userEmail.textContent = user.email;
    renderAvatar(user);
  }

  function populateForm(user: MyProfile) {
    renderSavedProfile(user);
    nameInput.value = user.name ?? '';
    pictureInput.value = user.picture ?? '';
    phoneInput.value = user.phone ?? '';
    addressInput.value = user.address ?? '';
  }

  const loadProfile = createProfileLoader({
    loading,
    content,
    error: document.getElementById('profile-error')!,
    errorMessage: document.getElementById('profile-error-message')!,
    retryButton: document.getElementById('profile-retry-btn') as HTMLButtonElement,
    focusAfterRetry: nameInput,
    load: async () => {
      populateForm(await apiFetch<MyProfile>('/api/me'));
    },
  });
  await loadProfile();

  const saveProfile = createProfileSaver({
    inputs: { name: nameInput, picture: pictureInput, phone: phoneInput, address: addressInput },
    button: saveBtn,
    status: document.getElementById('profile-save-status')!,
    save: (draft) => apiFetch<MyProfile>('/api/me', {
      method: 'PATCH',
      body: JSON.stringify({
        name: draft.name || null,
        picture: draft.picture || null,
        phone: draft.phone || null,
        address: draft.address || null,
      }),
    }),
    renderSavedProfile,
    showMessage: showToast,
  });
  saveBtn.addEventListener('click', saveProfile);

  logoutBtn.addEventListener('click', async () => {
    logoutBtn.disabled = true;
    logoutBtn.textContent = 'ログアウト中...';
    await fetch('/auth/logout', { method: 'POST', credentials: 'same-origin' });
    window.location.href = '/';
  });

  const deleteAccountBtn = document.getElementById('delete-account-btn') as HTMLButtonElement;
  const deleteDialog = document.getElementById('delete-dialog') as HTMLDialogElement;
  const deleteConfirmInput = document.getElementById('delete-confirm-input') as HTMLInputElement;
  const deleteCancelBtn = document.getElementById('delete-cancel-btn') as HTMLButtonElement;
  const deleteExecuteBtn = document.getElementById('delete-execute-btn') as HTMLButtonElement;

  deleteAccountBtn.addEventListener('click', () => {
    deleteConfirmInput.value = '';
    deleteExecuteBtn.disabled = true;
    deleteDialog.showModal();
  });

  deleteConfirmInput.addEventListener('input', () => {
    deleteExecuteBtn.disabled = deleteConfirmInput.value !== 'DELETE';
  });

  deleteCancelBtn.addEventListener('click', () => {
    deleteDialog.close();
  });

  deleteExecuteBtn.addEventListener('click', async () => {
    deleteExecuteBtn.disabled = true;
    deleteExecuteBtn.textContent = '削除中...';
    try {
      await apiFetch('/api/me', { method: 'DELETE' });
      showToast('アカウントを削除しました', 'success');
      setTimeout(() => { window.location.href = '/'; }, 1000);
    } catch (err) {
      deleteExecuteBtn.disabled = false;
      deleteExecuteBtn.textContent = '削除する';
      showToast(err instanceof Error ? err.message : 'アカウント削除に失敗しました', 'error');
      deleteDialog.close();
    }
  });
</script>
