---
import Base from '../layouts/Base.astro';
---
<Base title="0g0 ID - ログイン履歴">
  <div class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full" style="max-width: 480px">
      <div class="card">
        <div class="flex items-center justify-between mb-4">
          <h1 class="text-2xl font-bold">ログイン履歴</h1>
          <a href="/profile" class="btn btn-ghost btn-sm">← プロフィール</a>
        </div>
        <p class="text-sm mb-6" style="color: var(--color-muted)">
          これまでのログイン履歴です。身に覚えのないログインがある場合は、パスワードの変更やセッションの無効化をご検討ください。
        </p>

        <div class="mb-4">
          <label for="provider-filter" class="block text-sm font-semibold mb-1.5">プロバイダー</label>
          <select
            id="provider-filter"
            class="w-full px-3 py-2 rounded text-sm"
            style="border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text)"
          >
            <option value="">すべて</option>
            <option value="google">google</option>
            <option value="line">line</option>
            <option value="twitch">twitch</option>
            <option value="github">github</option>
            <option value="x">x</option>
          </select>
        </div>

        <div id="history-results" aria-busy="true">
          <div id="loading" role="status" class="flex items-center justify-center gap-2 py-8" style="color: var(--color-muted)">
            <span class="spinner" aria-hidden="true"></span>
            <span>ログイン履歴を読み込み中...</span>
          </div>
          <div id="error" class="alert alert-error" style="display:none">
            <p id="error-message" role="alert"></p>
            <button id="retry-btn" type="button" class="btn btn-primary btn-full mt-3">もう一度読み込む</button>
          </div>
          <p id="history-summary" role="status" tabindex="-1" class="text-sm mb-3" style="color: var(--color-text)"></p>
          <div id="empty" class="text-center py-8" style="color: var(--color-muted); display:none">ログイン履歴はありません</div>
          <div id="list" style="display:none"></div>
          <div id="load-more-wrap" class="mt-4" style="display:none">
            <button id="load-more-btn" type="button" class="btn btn-ghost btn-full">もっと読み込む</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { apiFetch, formatDatetime } from '../lib/api';
  import { escapeHtml, truncate } from '../lib/helpers';
  import type { LoginEvent } from '@0g0-id/api-types';
  import { createLoginHistoryLoader, LOGIN_HISTORY_PAGE_SIZE } from '../lib/login-history-loader';

  const listEl = document.getElementById('list')!;

  function renderList(events: readonly LoginEvent[]): void {
    listEl.innerHTML = events
      .map((e) => {
        const ip = e.ip_address ? escapeHtml(e.ip_address) : '—';
        const country = e.country ? escapeHtml(e.country) : '—';
        const ua = e.user_agent ? escapeHtml(truncate(e.user_agent, 80)) : '—';
        const provider = escapeHtml(e.provider);
        return `
          <div class="flex items-center justify-between py-3.5 border-b last:border-b-0" style="border-color: var(--color-border)">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 text-sm">
                <span class="font-semibold">${provider}</span>
                <span style="color: var(--color-muted)">${formatDatetime(e.created_at)}</span>
              </div>
              <div class="text-xs mt-0.5" style="color: var(--color-muted)">
                IP: ${ip} ／ 国: ${country}
              </div>
              <div class="text-xs mt-0.5 truncate" style="color: var(--color-muted)" title="${e.user_agent ? escapeHtml(e.user_agent) : ''}">
                UA: ${ua}
              </div>
            </div>
          </div>
        `;
      })
      .join('');
  }

  const loadHistory = createLoginHistoryLoader<LoginEvent>({
    loading: document.getElementById('loading')!,
    results: document.getElementById('history-results')!,
    error: document.getElementById('error')!,
    errorMessage: document.getElementById('error-message')!,
    retryButton: document.getElementById('retry-btn') as HTMLButtonElement,
    empty: document.getElementById('empty')!,
    list: listEl,
    summary: document.getElementById('history-summary')!,
    loadMoreWrap: document.getElementById('load-more-wrap')!,
    loadMoreButton: document.getElementById('load-more-btn') as HTMLButtonElement,
    providerFilter: document.getElementById('provider-filter') as HTMLSelectElement,
    load: async (provider, offset, signal) => {
      const params = new URLSearchParams({
        limit: String(LOGIN_HISTORY_PAGE_SIZE),
        offset: String(offset),
      });
      if (provider) params.set('provider', provider);
      return apiFetch<LoginEvent[]>(`/api/me/login-history?${params}`, { signal });
    },
    render: renderList,
  });

  await loadHistory();
</script>
