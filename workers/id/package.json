{
  "name": "workers-id",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:assets": "tsx scripts/build-assets.ts",
    "preflight:deploy": "tsx scripts/preflight-deploy.ts",
    "migrate": "wrangler d1 migrations apply 0g0-id-db --remote",
    "deploy": "npm run preflight:deploy && wrangler d1 migrations apply 0g0-id-db --remote && vp build && npm run build:assets && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@0g0-id/shared": "*",
    "hono": "4.13.13",
    "jose": "^6.2.12",
    "tldts": "^7.4.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite-plus": "1.1.0",
    "wrangler": "4.149.0"
  }
}
